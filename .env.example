# Project Vajra environment template.
# Copy to .env (git-ignored) and fill in. Never commit .env.

# CARTO Basemaps API key (https://carto.com/basemaps/apikey).
# Non-commercial tier is free up to 5M tile requests/month; keep the
# OpenStreetMap + CARTO attribution visible on the map.
VAJRA_BASEMAPS__CARTO_KEY=
