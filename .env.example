# Project Vajra environment template.
# Copy to .env (git-ignored) and fill in. Never commit .env.

# CARTO Basemaps API key (https://carto.com/basemaps/apikey).
# Non-commercial tier is free up to 5M tile requests/month; keep the
# OpenStreetMap + CARTO attribution visible on the map.
VAJRA_BASEMAPS__CARTO_KEY=

# Copernicus CDS Personal Access Token (https://cds.climate.copernicus.eu/how-to-api).
# Also place url+key in ~/.cdsapirc so cdsapi picks it up automatically.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# NCMRWF Research Data Server (https://rds.ncmrwf.gov.in) — IMDAA reanalysis, NCUM fields.
NCMRWF_USERNAME=
NCMRWF_PASSWORD=

# NASA Earthdata Login (https://urs.earthdata.nasa.gov) — IMERG (implemented) / ISS LIS.
# One-time step: accept the GES DISC EULA (the login flow provides the approve_app link).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
